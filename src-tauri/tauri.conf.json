{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuickMark",
  "version": "0.1.0",
  "identifier": "app.quickmark.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "QuickMark",
        "width": 1100,
        "height": 760,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "category": "Productivity",
    "shortDescription": "A lightweight Markdown viewer and editor",
    "longDescription": "QuickMark is a lightweight desktop application for writing, previewing, opening, and saving Markdown documents.",
    "publisher": "Bryan Keary",
    "homepage": "https://github.com/InsolentFlunkey/quick-mark",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "mimeType": "text/markdown",
        "name": "Markdown document",
        "role": "Editor"
      },
      {
        "ext": ["txt"],
        "mimeType": "text/plain",
        "name": "Text document",
        "role": "Editor"
      }
    ]
  }
}
