{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "about-repository",
  "description": "Allow the QuickMark main window to open its repository in the default browser",
  "windows": ["main"],
  "permissions": [
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/InsolentFlunkey/quick-mark"
        }
      ]
    }
  ]
}
